{
  "expo": {
    "name": "track-mo-mobile",
    "slug": "track-mo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/trackmo-app-icon.png",
    "scheme": "trackmomobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/trackmo-app-icon.png"
    },
    "android": {
      "package": "com.trackmo.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4ED",
        "foregroundImage": "./assets/images/trackmo-foreground.png",
        "monochromeImage": "./assets/images/trackmo-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/trackmo-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6F4ED",
          "image": "./assets/images/trackmo-splash.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Track Mo to access your camera to scan receipt QR codes.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "128f3993-9324-44ef-afad-9ed6e78ac370"
      }
    },
    "owner": "track-mo-pake-ko"
  }
}
